@model ChatbotDevep.Models.Chatbot

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>AI Assistant</title>
    <script>

            function askQuestion(question) {

                document.querySelector(".message-input").value = question;

                document.querySelector("form").submit();
            }

    </script>

    <style>
            .suggestion {
                padding: 10px 15px;
                background: white;
                border: 1px solid #e2e8f0;
                border-radius: 20px;
                color: #475569;
                font-size: 13px;
                box-shadow: 0 3px 8px rgba(0,0,0,0.05);
                cursor: pointer;
                transition: 0.2s;
            }

                .suggestion:hover {
                    border-color: #6366f1;
                    color: #4f46e5;
                    transform: translateY(-2px);
                }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Segoe UI", Arial, sans-serif;
                min-height: 100vh;
                background: radial-gradient(circle at top left, #6366f1 0%, transparent 35%), radial-gradient(circle at bottom right, #8b5cf6 0%, transparent 35%), #111827;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 25px;
            }


            /* =========================
                       MAIN CHAT CONTAINER
                    ========================= */

            .chat-container {
                width: 900px;
                max-width: 100%;
                height: 720px;
                background: rgba(255,255,255,0.95);
                border-radius: 25px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                box-shadow: 0 30px 80px rgba(0,0,0,0.35);
                backdrop-filter: blur(15px);
            }


            /* =========================
                       HEADER
                    ========================= */

            .chat-header {
                padding: 22px 28px;
                background: linear-gradient( 135deg, #4f46e5, #7c3aed );
                color: white;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid rgba(255,255,255,0.15);
            }


            .header-left {
                display: flex;
                align-items: center;
                gap: 15px;
            }


            .bot-icon {
                width: 58px;
                height: 58px;
                background: rgba(255,255,255,0.18);
                border: 1px solid rgba(255,255,255,0.3);
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 30px;
                box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            }


            .header-content h1 {
                font-size: 22px;
                margin-bottom: 4px;
            }


            .header-content p {
                font-size: 13px;
                opacity: 0.85;
            }


            .online-status {
                display: flex;
                align-items: center;
                gap: 7px;
                background: rgba(255,255,255,0.12);
                padding: 8px 12px;
                border-radius: 20px;
                font-size: 12px;
            }


            .online-dot {
                width: 8px;
                height: 8px;
                background: #22c55e;
                border-radius: 50%;
                box-shadow: 0 0 8px #22c55e;
            }


            /* =========================
                       CHAT BODY
                    ========================= */

            .chat-body {
                flex: 1;
                overflow-y: auto;
                padding: 30px;
                background: linear-gradient( 180deg, #f8fafc, #f1f5f9 );
            }


                /* Scrollbar */

                .chat-body::-webkit-scrollbar {
                    width: 7px;
                }

                .chat-body::-webkit-scrollbar-track {
                    background: transparent;
                }

                .chat-body::-webkit-scrollbar-thumb {
                    background: #cbd5e1;
                    border-radius: 10px;
                }


            /* =========================
                       WELCOME SCREEN
                    ========================= */

            .welcome {
                text-align: center;
                max-width: 550px;
                margin: 70px auto;
            }


            .welcome-icon {
                width: 90px;
                height: 90px;
                margin: 0 auto 22px;
                border-radius: 25px;
                background: linear-gradient( 135deg, #4f46e5, #8b5cf6 );
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 45px;
                box-shadow: 0 15px 30px rgba(79,70,229,0.3);
            }


            .welcome h2 {
                font-size: 28px;
                color: #1e293b;
                margin-bottom: 10px;
            }


            .welcome p {
                color: #64748b;
                font-size: 15px;
                line-height: 1.6;
            }


            .suggestions {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 25px;
            }


            .suggestion {
                padding: 10px 15px;
                background: white;
                border: 1px solid #e2e8f0;
                border-radius: 20px;
                color: #475569;
                font-size: 13px;
                box-shadow: 0 3px 8px rgba(0,0,0,0.05);
            }


            /* =========================
                       MESSAGES
                    ========================= */

            .message {
                display: flex;
                margin-bottom: 25px;
                animation: messageAppear 0.3s ease;
            }


            @@keyframes messageAppear {

                from {
                    opacity: 0;
                    transform: translateY(10px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }


            .message.user {
                justify-content: flex-end;
            }


            .message.bot {
                justify-content: flex-start;
            }


            .message-content {
                max-width: 75%;
            }


            .message-label {
                font-size: 12px;
                font-weight: 600;
                margin-bottom: 7px;
                color: #64748b;
            }


            .user .message-label {
                text-align: right;
                color: #4f46e5;
            }


            .bot .message-label {
                color: #16a34a;
            }


            .message-box {
                padding: 14px 18px;
                line-height: 1.6;
                font-size: 14px;
                word-wrap: break-word;
            }


            .user-message {
                color: white;
                background: linear-gradient( 135deg, #4f46e5, #6366f1 );
                border-radius: 18px 18px 4px 18px;
                box-shadow: 0 6px 15px rgba(79,70,229,0.2);
            }


            .bot-message {
                color: #334155;
                background: white;
                border: 1px solid #e2e8f0;
                border-radius: 18px 18px 18px 4px;
                box-shadow: 0 5px 15px rgba(15,23,42,0.06);
            }


            /* =========================
                       ERROR
                    ========================= */

            .error-message {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 14px 18px;
                margin-bottom: 20px;
                background: #fef2f2;
                color: #b91c1c;
                border: 1px solid #fecaca;
                border-radius: 12px;
                font-size: 14px;
            }


            /* =========================
                       FOOTER
                    ========================= */

            .chat-footer {
                padding: 20px 25px;
                background: white;
                border-top: 1px solid #e2e8f0;
            }


            .input-area {
                display: flex;
                align-items: center;
                gap: 12px;
                background: #f8fafc;
                border: 2px solid #e2e8f0;
                padding: 7px;
                border-radius: 16px;
                transition: 0.3s;
            }


                .input-area:focus-within {
                    border-color: #6366f1;
                    box-shadow: 0 0 0 4px rgba(99,102,241,0.1);
                    background: white;
                }


            .message-input {
                flex: 1;
                border: none;
                outline: none;
                background: transparent;
                padding: 12px 15px;
                font-size: 14px;
                color: #334155;
            }


                .message-input::placeholder {
                    color: #94a3b8;
                }


            .send-button {
                border: none;
                padding: 12px 22px;
                border-radius: 12px;
                background: linear-gradient( 135deg, #4f46e5, #7c3aed );
                color: white;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: 0.25s;
                box-shadow: 0 5px 12px rgba(79,70,229,0.25);
            }


                .send-button:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 18px rgba(79,70,229,0.35);
                }


                .send-button:active {
                    transform: translateY(0);
                }


            .footer-text {
                text-align: center;
                margin-top: 12px;
                color: #94a3b8;
                font-size: 11px;
            }


            /* =========================
                       MOBILE
                    ========================= */

            @@media (max-width: 700px) {

                body {
                    padding: 10px;
                }

                .chat-container {
                    height: 95vh;
                    border-radius: 18px;
                }

                .chat-header {
                    padding: 18px;
                }

                .online-status {
                    display: none;
                }

                .chat-body {
                    padding: 18px;
                }

                .message-content {
                    max-width: 88%;
                }

                .welcome {
                    margin: 50px auto;
                }

                    .welcome h2 {
                        font-size: 24px;
                    }

                .chat-footer {
                    padding: 15px;
                }

                .send-button {
                    padding: 12px 16px;
                }
            }

            .bot-message h1,
            .bot-message h2,
            .bot-message h3 {
                color: #1e293b;
                margin-top: 15px;
                margin-bottom: 10px;
            }

            .bot-message h2 {
                font-size: 21px;
            }

            .bot-message h3 {
                font-size: 17px;
            }

            .bot-message p {
                margin-bottom: 12px;
            }

            .bot-message ul,
            .bot-message ol {
                margin-left: 25px;
                margin-bottom: 15px;
            }

            .bot-message li {
                margin-bottom: 6px;
            }

            .bot-message strong {
                color: #4f46e5;
            }

            .bot-message code {
                background: #f1f5f9;
                color: #dc2626;
                padding: 3px 6px;
                border-radius: 5px;
                font-family: Consolas, monospace;
            }

            .bot-message pre {
                background: #1e293b;
                color: #f8fafc;
                padding: 16px;
                border-radius: 10px;
                overflow-x: auto;
                margin: 15px 0;
                font-family: Consolas, monospace;
                font-size: 13px;
                line-height: 1.5;
            }

                .bot-message pre code {
                    background: transparent;
                    color: #f8fafc;
                    padding: 0;
                }

            .bot-message blockquote {
                border-left: 4px solid #6366f1;
                padding-left: 15px;
                margin: 15px 0;
                color: #64748b;
            }

            .bot-message table {
                width: 100%;
                border-collapse: collapse;
                margin: 15px 0;
            }

            .bot-message th,
            .bot-message td {
                border: 1px solid #e2e8f0;
                padding: 8px;
                text-align: left;
            }

            .bot-message th {
                background: #f1f5f9;
                font-weight: bold;
            }
    </style>

</head>


<body>


    <div class="chat-container">


        <!-- ================= HEADER ================= -->

        <div class="chat-header">

            <div class="header-left">

                <div class="bot-icon">
                    🤖
                </div>

                <div class="header-content">

                    <h1>AI Assistant</h1>

                    <p>
                        Your smart .NET learning companion
                    </p>

                </div>

            </div>


            <div class="online-status">

                <span class="online-dot"></span>

                Online

            </div>

        </div>



        <!-- ================= CHAT BODY ================= -->

        <div class="chat-body">


            @if (ViewBag.Error != null)
            {

                <div class="error-message">

                    ⚠️

                    <span>
                        @ViewBag.Error
                    </span>

                </div>

            }



            @if (ViewBag.UserMessage != null)
            {

                <!-- USER MESSAGE -->

                <div class="message user">

                    <div class="message-content">

                        <div class="message-label">

                            👤 You

                        </div>

                        <div class="message-box user-message">

                            @ViewBag.UserMessage

                        </div>

                    </div>

                </div>


            }
            else
            {

                <!-- WELCOME -->

                <div class="welcome">

                    <div class="welcome-icon">

                        🤖

                    </div>


                    <h2>
                        How can I help you today?
                    </h2>


                    <p>

                        Ask me anything about

                        <strong>C#</strong>,

                        <strong>.NET</strong>,

                        <strong>SQL</strong>,

                        <strong>ASP.NET MVC</strong>

                        or programming.

                    </p>


                    <div class="suggestions">

                        <button class="suggestion"
                                onclick="askQuestion('What is C#?')">
                            💻 What is C#?
                        </button>

                        <button class="suggestion"
                                onclick="askQuestion('Explain MVC in ASP.NET Core')">
                            🌐 Explain MVC
                        </button>

                        <button class="suggestion"
                                onclick="askQuestion('Give me SQL interview questions')">
                            🗄️ SQL interview questions
                        </button>

                        <button class="suggestion"
                                onclick="askQuestion('Explain ADO.NET')">
                            ⚡ Explain ADO.NET
                        </button>

                    </div>

                </div>

            }



            @if (ViewBag.BotReply != null)
            {

                <!-- BOT MESSAGE -->

                <div class="message bot">

                    <div class="message-content">

                        <div class="message-label">

                            🤖 AI Assistant

                        </div>

                        <div class="message-box bot-message">

                            @Html.Raw(ViewBag.BotReply)

                        </div>

                    </div>

                </div>

            }


        </div>



        <!-- ================= FOOTER ================= -->

        <div class="chat-footer">


            <form asp-controller="Chatbot"
                  asp-action="Chat"
                  method="post">


                <div class="input-area">


                    <input type="text"
                           name="userMessage"
                           class="message-input"
                           placeholder="Ask me anything..."
                           autocomplete="off"
                           required />


                    <button type="submit"
                            class="send-button">

                        Send ➤

                    </button>


                </div>


            </form>


            <div class="footer-text">

                🔒 Your conversation is handled securely

                • ASP.NET Core MVC

            </div>


        </div>


    </div>


</body>

</html>